{
  "name": "virens",
  "version": "1.0.0",
  "private": true,
  "description": "Virens \u2014 frontend-only creator-centric visual discovery platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@virens/web",
    "build": "turbo run build --filter=@virens/web",
    "lint": "turbo run lint --filter=@virens/web",
    "type-check": "turbo run type-check --filter=@virens/web",
    "clean": "turbo run clean --filter=@virens/web",
    "dev:web": "pnpm --filter @virens/web dev",
    "build:web": "pnpm --filter @virens/web build",
    "build:all": "pnpm build:web"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
